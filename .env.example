# GitLab personal access token (read_api scope)
# Create one at: GitLab → Settings → Access Tokens
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# User accounts — JSON object mapping usernames to bcrypt hashes (cost factor 12)
# Generate a hash: node -e "const b = require('bcryptjs'); b.hash('yourpassword', 12).then(h => console.log(h))"
# IMPORTANT: escape every $ in the hash as \$ — otherwise dotenv expands it as a shell variable
AUTH_USERS={"alice":"\$2b\$12\$<hash>","bob":"\$2b\$12\$<hash>"}

# Secret for signing session cookies — must be a random 64-character hex string
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=your_64_char_hex_secret_here
